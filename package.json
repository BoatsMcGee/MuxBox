{
  "name": "muxbox",
  "description": "Batch multiplexer with heuristics-based stream selection",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "author": {
    "name": "Boats McGee",
    "email": "142189976+BoatsMcGee@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/BoatsMcGee/MuxBox#readme",
  "bugs": {
    "url": "https://github.com/BoatsMcGee/MuxBox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoatsMcGee/MuxBox.git"
  },
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "build": "npm run build -ws --if-present",
    "compile": "npm run build && electron-builder build --config electron-builder.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "playwright test",
    "start": "node packages/dev-mode.js",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -ws --if-present",
    "fetch:tools": "node scripts/fetch-external-tools.mjs",
    "postinstall": "patch-package",
    "clean": "rimraf dist packages/main/dist packages/preload/dist packages/renderer/dist",
    "deepclean": "npm run clean && rimraf --glob node_modules patches packages/*/node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@npmcli/map-workspaces": "5.0.3",
    "@playwright/test": "1.58.2",
    "@types/node": "25.5.0",
    "@vue/test-utils": "^2.4.11",
    "electron": "^42.3.0",
    "electron-builder": "26.8.1",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "glob": "13.0.6",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.58.2",
    "rimraf": "^6.0.1",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@app/main": "*"
  }
}
